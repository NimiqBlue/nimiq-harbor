# Local defaults only. No production values or non-empty dummy API keys.
NODE_ENV=development
HOST=127.0.0.1
PORT=18787
APP_ORIGIN=http://localhost:14173
HARBOR_DB_PATH=.data/harbor-local.sqlite

# Optional browser-visible activation key; restart/rebuild after setting your own.
# NEVER put a server secret in any VITE_* variable.
VITE_MTPELERIN_KEY=

# Optional server-only quote access. Never expose in browser configuration.
ONEINCH_API_KEY=
FUSION_EXECUTION_ENABLED=false
POLYGON_RPC_URL=
# Optional persistent key: canonical base64 of 32 locally generated random bytes.
TOKEN_ENCRYPTION_KEY=

# Do not set HARBOR_SESSION_NAMESPACE unless using its ONLY accepted value: swap.
# No 0x credential variable is consumed by the inspected active source.
